{
  "name": "todoist-box",
  "version": "1.0.0",
  "description": "📊 Update a gist to contain your Todoist stats",
  "author": "Josh",
  "license": "MIT",
  "scripts": {
    "build": "ncc build index.js --out dist --minify --target es2022",
    "lint": "oxlint --deny-warnings index.js test",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test --experimental-test-coverage --test-coverage-include=index.js --test-coverage-lines=75 'test/**/*.test.js'"
  },
  "dependencies": {
    "@actions/github": "^6.0.1",
    "@octokit/rest": "22.0.1",
    "dotenv": "17.4.2",
    "humanize-number": "0.0.2"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.4",
    "husky": "9.1.7",
    "oxlint": "^1.95.0",
    "prettier": "3.10.1",
    "pretty-quick": "4.2.2"
  },
  "packageManager": "yarn@4.12.0",
  "overrides": {
    "picomatch": "~4.0.4",
    "undici": "~8.12.4"
  }
}
